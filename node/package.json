{
  "author": "davekpatrick",
  "name": "@davekpatrick/action-release-version",
  "license": "BSD-3-Clause",
  "version": "0.0.0",
  "description": "GitHub Action to caculate a required release version",
  "keywords": [
    "node",
    "github",
    "actions",
    "release",
    "version"
  ],
  "main": "index.js",
  "config": {
    "NODE_ENV": "production"
  },
  "scripts": {
    "format": "prettier --write  --no-semi ../node ../tests",
    "validate": "eslint ../node ../tests",
    "build-add-metadata": "replace @@NPM_PACKAGE_NAME@@ $npm_package_name ../dist/index.js && replace @@NPM_PACKAGE_VERSION@@ $npm_package_version ../dist/index.js",
    "build-add-config-files": "node -e \"require('fs').cpSync('etc', '../dist/etc', {recursive: true})\"",
    "build": "NODE_ENV=$npn_package_config_nodeenv; ncc build index.js --license licenses.txt --out ../dist && npm run build-add-config-files && npm run build-add-metadata",
    "test": "mocha"
  },
  "dependencies": {
    "@actions/core": "1.11.1",
    "@actions/github": "6.0.0",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@vercel/ncc": "0.38.1",
    "chai": "4.3.10",
    "eslint": "8.53.0",
    "js-yaml": "4.3.1",
    "mocha": "11.7.2",
    "prettier": "3.0.3",
    "proxyquire": "2.1.3",
    "replace": "1.2.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/davekpatrick/action-release-version"
  }
}
